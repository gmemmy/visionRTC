{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "lib/typescript",
    "composite": true,
    "tsBuildInfoFile": "./lib/.tsbuildinfo/source-visioncamera.build.tsbuildinfo",
    "paths": {
      "@visionrtc/core": ["../core/src/index.ts"],
      "@visionrtc/core/*": ["../core/src/*"]
    }
  },
  "include": ["src/**/*", "register.ts"],
  "exclude": ["lib", "node_modules"]
}
