{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "lib/typescript",
    "composite": true,
    "tsBuildInfoFile": "./lib/.tsbuildinfo/source-visioncamera.build.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["lib", "node_modules"]
}
